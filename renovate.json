{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorMinor",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Peer ranges are what apps may use; Renovate leaves them alone.",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "Mantine moves together.",
      "matchPackageNames": ["@mantine/**"],
      "groupName": "Mantine"
    },
    {
      "description": "Storybook moves together.",
      "matchPackageNames": ["storybook", "@storybook/**"],
      "groupName": "Storybook"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "The Playwright image in CI must match @playwright/test, or the browser is missing.",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "Playwright",
      "groupSlug": "playwright"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
