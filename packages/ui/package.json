{
  "name": "@bitsandbricks/ui",
  "version": "0.2.0",
  "description": "BitsAndBricks React components on Mantine: theme, page head, tables, filters, panels, shell",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitsandbricks-ch/ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "theme-script.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spotlight": {
      "types": "./dist/spotlight.d.ts",
      "default": "./dist/spotlight.js"
    },
    "./dates": {
      "types": "./dist/dates/index.d.ts",
      "default": "./dist/dates/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme-script.js": "./theme-script.js"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@bitsandbricks/tokens": "workspace:^",
    "@tanstack/react-table": "^8.21.3"
  },
  "peerDependencies": {
    "@mantine/core": "^9.7.4",
    "@mantine/dates": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@mantine/spotlight": "^9.7.4",
    "@tabler/icons-react": "^3.40.0",
    "dayjs": "^1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@mantine/spotlight": {
    "@mantine/dates": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    }
  }
}
